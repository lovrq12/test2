# ─────────────────────────────────────────────────────────────────────────────
# .env.example
# Arabic Mafia Online — Environment Variables Template
#
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in ALL values marked with  ← FILL THIS
#   3. NEVER commit .env to git (it is in .gitignore)
# ─────────────────────────────────────────────────────────────────────────────


# ─── SERVER ──────────────────────────────────────────────────────────────────

NODE_ENV=development
# Options: development | production | test

PORT=3000
# Port the Node.js server will listen on

HOST=0.0.0.0
# Use 0.0.0.0 to accept connections on all interfaces


# ─── CORS ────────────────────────────────────────────────────────────────────

CORS_ORIGIN=http://localhost:5500
# In development: your frontend dev server URL (e.g., Live Server default)
# In production: your actual domain, e.g. https://yourmafiagame.com
# Multiple origins: comma-separated — https://domain1.com,https://domain2.com


# ─── REDIS ───────────────────────────────────────────────────────────────────

REDIS_URL=redis://localhost:6379
# Local dev with docker-compose: redis://localhost:6379
# With auth:                     redis://:password@localhost:6379
# Cloud (e.g. Upstash):          rediss://default:TOKEN@host.upstash.io:6380

REDIS_TTL_HOURS=2
# How long room data lives in Redis before auto-expiry (default: 2 hours)


# ─── MONGODB ─────────────────────────────────────────────────────────────────

MONGODB_URI=mongodb://localhost:27017/mafia-game
# Local dev with docker-compose: mongodb://localhost:27017/mafia-game
# MongoDB Atlas:                 mongodb+srv://user:pass@cluster.mongodb.net/mafia-game
# With auth:                     mongodb://user:pass@localhost:27017/mafia-game

MONGODB_DB_NAME=mafia-game


# ─── SESSION / SECURITY ──────────────────────────────────────────────────────

SESSION_SECRET=change_this_to_a_long_random_string_in_production
# ← FILL THIS — use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be at least 32 characters. Must be secret. Never commit a real value.


# ─── GAME LIMITS ─────────────────────────────────────────────────────────────

MAX_ROOMS=500
# Maximum number of concurrent active rooms on this server instance

MAX_PLAYERS_PER_ROOM=8
# Hard cap (also enforced in shared/constants.js — keep in sync)

ROOM_CREATION_RATE_LIMIT=3
# Max rooms one IP can create per hour (anti-abuse)


# ─── FIREBASE (Authentication + Firestore) ───────────────────────────────────
# Leave as placeholders until Firebase project is set up.
# These are used in the frontend (public values — safe to expose in JS).

FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
# ← FILL THIS when Firebase project is ready

FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
# ← FILL THIS

FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
# ← FILL THIS

FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
# ← FILL THIS

FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
# ← FILL THIS

FIREBASE_APP_ID=YOUR_APP_ID
# ← FILL THIS


# ─── LOGGING ─────────────────────────────────────────────────────────────────

LOG_LEVEL=debug
# Options: error | warn | info | debug
# Use 'info' in production, 'debug' in development

LOG_TO_FILE=false
# Set to true in production to write logs to /logs/ directory


# ─── DEPLOYMENT (Vercel frontend — set in Vercel dashboard, not here) ────────
# These are documented here for reference only.
# VERCEL_URL — automatically set by Vercel
# Add CORS_ORIGIN in Vercel environment variables pointing to your backend URL
